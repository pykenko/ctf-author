# Host/IP players should use for spawned challenge URLs.
INSTANCE_HOST=103.152.242.110
PUBLIC_SCHEME=http

# CTFd is the identity source. The instancer forwards player access tokens here.
CTFD_BASE_URL=http://103.185.52.173/

# Bind publicly for direct remote access. For stronger token protection, set
# INSTANCER_BIND=127.0.0.1 and expose it through an HTTPS reverse proxy.
INSTANCER_BIND=0.0.0.0
INSTANCER_HOST=0.0.0.0
INSTANCER_PORT=9000

# Protects admin-only endpoints such as /instances, DELETE /instances/<team>, and /cleanup.
INSTANCER_ADMIN_TOKEN=change-this-long-random-admin-token

# Port range exposed on INSTANCE_HOST for per-team frontend containers.
PORT_MIN=20000
PORT_MAX=30000

# Per-team lifetime. /spawn never exceeds MAX_INSTANCE_TTL_SECONDS.
INSTANCE_TTL_SECONDS=1200
MAX_INSTANCE_TTL_SECONDS=1200
CLEANUP_INTERVAL_SECONDS=60

# Set to 0 only if this is an individual-mode CTFd event.
REQUIRE_TEAM=1

# Optional label included in request logs.
CTFD_CHALLENGE_ID=

# Persistent state. The service user needs read/write access here.
DEJAVU_STATE_DIR=/var/lib/dejavu-instancer

# Set to 0 after images have been built if you want faster starts.
COMPOSE_BUILD=1
